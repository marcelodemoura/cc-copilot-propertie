# Configurações do CC Copilot Properties
# Copie este arquivo para .env e preencha as variáveis conforme seu ambiente:
# cp .env.example .env

# Banco de Dados (compatível com compose.yaml)
DB_URL=jdbc:postgresql://localhost:5434/copilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Segurança da API (obrigatório para requisições externas)
API_KEY=seu-token-secreto-aqui

# Perfil ativo: 'mock' (local sem custos), 'openai' ou 'ollama'
SPRING_PROFILES_ACTIVE=mock

# OpenAI (necessário se SPRING_PROFILES_ACTIVE=openai)
OPENAI_API_KEY=sk-sua-chave-openai-aqui
OPENAI_MODEL=gpt-4o-mini

# Ollama (necessário se SPRING_PROFILES_ACTIVE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_EMBED_MODEL=nomic-embed-text

# Diretório base autorizado para varredura e indexação de projetos
INDEXER_BASE_PATH=.

